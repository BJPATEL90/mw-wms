<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>MW WMS — Floor App</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'DM Sans',system-ui,sans-serif;background:linear-gradient(160deg,#0c4a6e 0%,#0d9488 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;color:#fff;padding:20px}
  .card{background:rgba(255,255,255,.12);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:32px 24px;text-align:center;max-width:340px;width:100%}
  .logo{width:52px;height:52px;background:#0d9488;border-radius:13px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
  .logo svg{width:28px;height:28px;stroke:#fff;stroke-width:2;fill:none}
  h1{font-size:20px;font-weight:700;margin-bottom:4px}
  p{font-size:13px;opacity:.8;margin-bottom:22px;line-height:1.5}
  .loader{width:34px;height:34px;border:3px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 14px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .msg{font-size:13px;opacity:.7}
  .btn{display:inline-block;margin-top:18px;padding:13px 28px;background:#fff;color:#0d9488;border-radius:10px;font-size:15px;font-weight:600;text-decoration:none;cursor:pointer;width:100%;border:none}
  .back{margin-top:16px;font-size:12px;opacity:.6}
  .back a{color:#fff;text-decoration:underline}
</style>
</head>
<body>
<div class="card">
  <div class="logo">
    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  </div>
  <h1>Floor App</h1>
  <p>MW WMS — Mobile<br>Warehouse Floor Operations</p>
  <div class="loader" id="loader"></div>
  <div class="msg" id="msg">Opening floor app…</div>
  <a class="btn" id="manualBtn" style="display:none" href="#">Open Floor App</a>
  <div class="back"><a href="index.html">← Desktop WMS</a></div>
</div>
<script>
  var GAS = 'https://script.google.com/a/macros/mosaicwellness.in/s/AKfycbwOftOsHKyol0NPhQFy8waSCT5GFdaPkrqt45U8PEip8kLVn9tXJdd3HR1_ni5xbcM9/exec?page=mobile';
  window.location.replace(GAS);
  setTimeout(function(){
    document.getElementById('loader').style.display='none';
    document.getElementById('msg').innerText='Tap below if not redirected automatically.';
    var btn=document.getElementById('manualBtn');
    btn.href=GAS; btn.style.display='block';
  }, 2000);
</script>
</body>
</html>
